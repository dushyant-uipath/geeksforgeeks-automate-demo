      },
      "inputs": {},
      "outputs": {
        "status": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "\"discarded\"",
            "fieldType": "string"
          },
          "var": "status"
        },
        "subject": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.editor.output.subject",
            "fieldType": "string"
          },
          "var": "subject"
        }
      },
      "uniqueId": "f5d6b2d9-b720-46df-b72e-ed684a290ee6"
    }
  ],
  "edges": [
    {
      "id": "edge_0",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchNews",
      "targetPort": "input"
    },
    {
      "id": "edge_1",
      "sourceNodeId": "fetchNews",
      "sourcePort": "default",
      "targetNodeId": "prep",
      "targetPort": "input"
    },
    {
      "id": "edge_2",

    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.8",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": [
        "human-task",
        "hitl",
        "human-in-the-loop",
        "quick-form",
        "approval"
      ],
      "sortOrder": 50,
      "supportsErrorHandling": true,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "schema": {
          "fields": [
            {
              "id": "comments",
              "type": "string",
              "label": "Comments",
              "direction": "output"
            }
          ],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "user"
          }
        }
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status (completed, cancelled, timeout)",
          "source": "=result.Action",
          "var": "status"
        }
      },
      "form": {
        "id": "hitl-quick-form-properties",
        "title": "Quick Form Task Configuration",
        "sections": [
          {
            "id": "assignment",
            "title": "Assignment criteria",
            "collapsible": false,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.recipient",
                "type": "custom",
                "component": "hitl-assignee-selector",
                "label": "",
                "description": ""
              }
            ]
          },
          {
            "id": "schema",
            "title": "Schema",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.schema",
                "type": "custom",
                "component": "hitl-schema-editor",
                "label": "Task Schema",
                "description": "Define the input and output parameters for this task"
              }
            ]
          },
          {
            "id": "delivery",
            "title": "Delivery channels",
            "collapsible": false,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.recipient",
                "type": "custom",
                "component": "hitl-channel-selector",
                "label": "Delivery Channels",
                "description": "Select where the task should be sent"
              }
            ]
          },
          {
            "id": "additional-properties",
            "title": "Additional properties",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.title",
                "type": "text",
                "label": "Task title"
              },
              {
                "name": "inputs.priority",
                "type": "select",
                "label": "Priority",
                "options": [
                  {
                    "label": "Low",
                    "value": "Low"
                  },
                  {
                    "label": "Medium",
                    "value": "Medium"
                  },
                  {
                    "label": "High",
                    "value": "High"
                  }
                ]
              },
              {
                "name": "inputs.labels",
                "type": "text",
                "label": "Labels",
                "placeholder": "Comma-separated (e.g. finance,approval)"
              },
              {
                "name": "inputs.memorySpace",
                "type": "custom",
                "component": "hitl-memory-space-picker",
                "label": "Memory space",
                "description": "Attach a memory space so this task's inputs and outputs are written to it"
              }
            ]
          }
        ]
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    },
    {
      "nodeType": "core.logic.switch",
      "version": "1.2",
      "category": "control-flow",
      "description": "Route to one of many branches by condition",
      "tags": [
        "control-flow",
        "switch",
        "case",
        "when"
      ],
      "sortOrder": 62,
      "display": {
        "label": "Switch",
        "icon": "between-horizontal-start"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "case-{item.id}",
              "type": "source",
              "handleType": "output",
              "label": "{item.label || 'Case ' + (index + 1)}",
              "repeat": "inputs.cases"
            },
            {
              "id": "default",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.defaultBranch.label}",
              "visible": "{inputs.cases.length === 0 || inputs.defaultBranch.enabled !== false}"
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ExclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
            "minItems": 1,
            "errorMessage": "At least one case is required",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "errorMessage": "Add a condition"
                }
              },
              "required": [
                "expression"
              ]
            }
          },
          "defaultBranch": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "cases"
        ]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched case",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The ID of the matched case (\"default\" for the default branch)",
          "var": "matchedCaseId"
        }
      },
      "inputDefaults": {
        "cases": [
          {
            "id": "default-1",
            "label": "Case 1",
            "expression": ""
          },
          {
            "id": "default-2",
            "label": "Case 2",
            "expression": ""
          }
        ],
        "defaultBranch": {
          "enabled": true,
          "label": "Default"
        }
      },
      "form": {
        "id": "switch-properties",
        "title": "Switch configuration",
        "sections": [
          {
            "id": "cases",
            "title": "Cases",
            "description": "Each case is evaluated in order. The first condition that returns true is taken.",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.cases",
                "type": "custom",
                "label": "Switch cases",
                "component": "case-list-editor",
                "componentProps": {
                  "defaultBranchRow": true,
                  "minCases": 1,
                  "maxCases": 10,
                  "expressionPlaceholder": "$vars.httpRequest1.output.statusCode >= 200 && $vars.httpRequest1.output.statusCode < 300",
                  "expressionValidationFields": [
                    {
                      "subPath": "expression",
                      "validationMode": "expression",
                      "expectedType": "boolean"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a process path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 66,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
